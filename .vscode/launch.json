{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-vv"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: All (non-Spark)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-m", "not spark"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
